<Window x:Class="MediaTracker_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioBook Player" Height="650" Width="900"
        Background="#1A1A2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENIU -->
        <Menu Grid.Row="0" Background="#0F1628" Foreground="White">
            <MenuItem Header="Library" Foreground="White" Background="#0F1628">
                <MenuItem x:Name="MenuAddBook" Header="Add Book" Click="MenuAddBook_Click"
                          Foreground="White" Background="#16213E"/>
                <MenuItem x:Name="MenuRemoveBook" Header="Remove Book" Click="MenuRemoveBook_Click"
                          Foreground="White" Background="#16213E"/>
                <Separator Background="#0F3460"/>
                <MenuItem x:Name="MenuExit" Header="Exit" Click="MenuExit_Click"
                          Foreground="White" Background="#16213E"/>
            </MenuItem>
            <MenuItem Header="Help" Foreground="White" Background="#0F1628">
                <MenuItem x:Name="MenuAbout" Header="About" Click="MenuAbout_Click"
                          Foreground="White" Background="#16213E"/>
            </MenuItem>
        </Menu>

        <!-- CONTINUT PRINCIPAL -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLOANA STANGA - Lista de carti -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="My Books" Foreground="#E94560"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBox x:Name="SearchBox"
                         Background="#16213E" Foreground="White"
                         BorderBrush="#0F3460" BorderThickness="1"
                         FontSize="13" Padding="6,4" Margin="0,0,0,8"
                         TextChanged="SearchBox_TextChanged"/>

                <ListBox x:Name="BooksListBox"
                         Background="#16213E" Foreground="White"
                         BorderBrush="#0F3460" Height="480" FontSize="13"
                         SelectionChanged="BooksListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} chapters'}"
                                           Foreground="#8892B0" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- COLOANA DREAPTA - Capitole + Player -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Info carte selectata -->
                <StackPanel Grid.Row="0" x:Name="BookInfoPanel"
                            Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock x:Name="BookTitleText" Foreground="#E94560"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="BookInfoText" Foreground="#8892B0" FontSize="12"/>
                </StackPanel>

                <!-- Lista capitole -->
                <ListBox Grid.Row="1" x:Name="ChaptersListBox"
                         Background="#16213E" Foreground="White"
                         BorderBrush="#0F3460" FontSize="13"
                         SelectionChanged="ChaptersListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,6" Width="480">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White" FontWeight="SemiBold"/>
                                    <!-- Bara de progres -->
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Maximum="100" Height="4"
                                                 Background="#2A3A5A"
                                                 Foreground="#E94560"
                                                 BorderThickness="0"
                                                 Margin="0,4,0,2"/>
                                    <TextBlock Text="{Binding ProgressPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}"
                                               Foreground="#8892B0" FontSize="10"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SavedPosition, StringFormat='{}{0:F0}s'}"
                                           Foreground="#8892B0" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- PLAYER BAR (jos) -->
        <Border Grid.Row="2" Background="#0F1628"
                BorderBrush="#16213E" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Info capitol curent -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="NowPlayingTitle" Text="No chapter selected"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NowPlayingBook" Text=""
                               Foreground="#8892B0" FontSize="12"/>
                </StackPanel>

                <!-- Controale player -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,0,0,8">
                        <Button Content="⏮" Click="PrevButton_Click"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" FontSize="18"
                                Width="36" Height="36" Cursor="Hand"/>
                        <Button x:Name="PlayPauseButton" Content="▶"
                                Click="PlayPauseButton_Click"
                                Background="#E94560" Foreground="White"
                                BorderThickness="0" FontSize="20"
                                Width="48" Height="48" Cursor="Hand"
                                Margin="8,0"/>
                        <Button Content="⏭" Click="NextButton_Click"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" FontSize="18"
                                Width="36" Height="36" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Slider progres -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionText" Grid.Column="0"
                                   Text="0:00" Foreground="#8892B0" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Slider x:Name="ProgressSlider" Grid.Column="1"
                                Minimum="0" Maximum="100"
                                VerticalAlignment="Center"
                                ValueChanged="ProgressSlider_ValueChanged"
                                Thumb.DragStarted="ProgressSlider_DragStarted"
                                Thumb.DragCompleted="ProgressSlider_DragCompleted"/>
                        <TextBlock x:Name="DurationText" Grid.Column="2"
                                   Text="0:00" Foreground="#8892B0" FontSize="11"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Volum -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔊" Foreground="#8892B0"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1"
                            Value="0.7" Width="80" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>